# Netlify response headers. Each article page names its Markdown twin in a <link rel="alternate"> in its head
# (layouts/_partials/head.html), so the twins need no Link header here.

# The knowledge bundle: all Markdown, cached at the edge.
/okf/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Each article's Markdown twin (/articles/<slug>.md).
/articles/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
