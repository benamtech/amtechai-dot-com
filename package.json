{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run okf:build && vite build",
    "postbuild": "node scripts/okf/prerender.ts && node scripts/seo/validate-seo.ts",
    "okf:prerender": "node scripts/okf/prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "okf:build": "node scripts/okf/build-okf.ts",
    "okf:validate": "node scripts/okf/validate-okf.ts",
    "okf:validate:phase3": "node scripts/okf/validate-okf.ts --phase=3",
    "okf:db:seed-sql": "node scripts/okf/db-seed-sql.ts",
    "okf:db:verify": "node scripts/okf/db-verify.ts",
    "okf:check": "npm run okf:build && npm run okf:validate",
    "article-system:validate": "node scripts/seo/validate-article-system.ts",
    "seo:validate": "node scripts/seo/validate-seo.ts",
    "seo:check": "npm run build && npm run seo:validate"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/three": "^0.184.1",
    "framer-motion": "^12.34.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
