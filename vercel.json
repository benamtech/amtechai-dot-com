    {"source": "/articles/(.*)\\.md", "headers": [{"key": "Content-Type", "value": "text/markdown; charset=utf-8"}, {"key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source": "/llms.txt", "headers": [{"key": "Content-Type", "value": "text/markdown; charset=utf-8"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]}
  ],
